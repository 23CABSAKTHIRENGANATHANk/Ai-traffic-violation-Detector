# Environment Variables Template

# This file shows all required environment variables for the project.
# Copy this to .env.local and fill in your actual values.
# Never commit the actual .env file to Git!

# =====================================================
# FRONTEND (.env.local or Vercel Environment Variables)
# =====================================================

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_AI_SERVICE_URL=http://localhost:8000

# Optional: Analytics & Monitoring
VITE_SENTRY_DSN=
VITE_GA_ID=

# =====================================================
# BACKEND (backend/.env or Vercel Environment Variables)
# =====================================================

# Node Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/traffic_violations
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=traffic_violations

# AI Service
AI_SERVICE_URL=http://localhost:8000

# API Configuration
PORT=3000
API_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Optional: Email Service (if needed)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@traffic-detector.com

# Optional: Payment Gateway (if needed)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# =====================================================
# AI SERVICE (ai_service/.env or Hugging Face Secrets)
# =====================================================

# Flask/FastAPI Configuration
FLASK_ENV=development
DEBUG=1
PYTHONUNBUFFERED=1

# Model Configuration
MODEL_PATH=./yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
MAX_UPLOAD_SIZE=100MB

# API Port
API_PORT=8000

# Optional: Hugging Face Specific
HF_SPACE=1
HF_API_KEY=

# =====================================================
# DOCKER COMPOSE (.env for docker-compose.yml)
# =====================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=traffic_violations
POSTGRES_HOST_AUTH_METHOD=md5

# =====================================================
# VERCEL DEPLOYMENT VARIABLES
# =====================================================

# Frontend
VITE_API_URL=https://your-backend-domain.vercel.app/api
VITE_AI_SERVICE_URL=https://huggingface.co/spaces/YOUR_USERNAME/ai-traffic-detector

# Backend
DATABASE_URL=postgresql://user:password@your-db-host:5432/traffic_violations
AI_SERVICE_URL=https://huggingface.co/spaces/YOUR_USERNAME/ai-traffic-detector
NODE_ENV=production

# =====================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =====================================================

# 1. PostgreSQL / Supabase
# - Create account at supabase.com or use your PostgreSQL provider
# - Get connection string
# - Set DATABASE_URL

# 2. Vercel Deployment
# - Sign up at vercel.com
# - Connect GitHub repo
# - Add all environment variables
# - Deploy frontend and backend

# 3. Hugging Face Deployment
# - Sign up at huggingface.co
# - Create Space (Docker)
# - Deploy AI service

# 4. Update API URLs
# - Update VITE_API_URL in frontend
# - Update AI_SERVICE_URL in backend

# =====================================================
# SECURITY BEST PRACTICES
# =====================================================

# ⚠️ IMPORTANT SECURITY NOTES:
# 1. NEVER commit .env files to Git
# 2. Use strong passwords for databases
# 3. Keep API keys secret
# 4. Use HTTPS for all production URLs
# 5. Rotate credentials regularly
# 6. Use environment variable secrets in CI/CD
# 7. Never expose sensitive data in frontend code
# 8. Use CORS headers carefully
# 9. Implement rate limiting
# 10. Monitor for suspicious activity

# =====================================================
# LOCAL DEVELOPMENT
# =====================================================

# For Docker Compose
docker-compose up -d

# For manual startup
# Terminal 1 - Backend
cd backend && npm install && npm start

# Terminal 2 - Frontend
cd frontend && npm install && npm run dev

# Terminal 3 - AI Service
cd ai_service && pip install -r requirements.txt && python app.py

# =====================================================
# TESTING
# =====================================================

# Test backend API
curl http://localhost:3000/api/violations

# Test AI service
curl http://localhost:8000/health

# Test database
psql $DATABASE_URL -c "SELECT 1"

# =====================================================
# PRODUCTION DEPLOYMENT
# =====================================================

# 1. Set all environment variables in Vercel dashboard
# 2. Deploy backend:
#    cd backend && vercel --prod

# 3. Deploy frontend:
#    cd frontend && vercel --prod

# 4. Deploy AI service to Hugging Face Spaces
#    Push to: https://huggingface.co/spaces/YOUR_USERNAME/ai-traffic-detector

# 5. Update frontend environment variables with production URLs
# 6. Test all endpoints
# 7. Monitor logs and errors

# =====================================================
# USEFUL LINKS
# =====================================================

# PostgreSQL: https://www.postgresql.org/
# Supabase: https://supabase.com/
# Vercel: https://vercel.com/
# Hugging Face: https://huggingface.co/
# Node.js: https://nodejs.org/
# Python: https://www.python.org/
# Docker: https://www.docker.com/

