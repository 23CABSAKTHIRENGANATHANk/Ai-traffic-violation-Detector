# Production Environment Variables for Vercel Deployment

# Backend Configuration
NODE_ENV=production
DATABASE_URL=postgresql://user:password@db.example.com:5432/traffic_violations
DB_HOST=db.example.com
DB_PORT=5432
DB_USER=traffic_user
DB_PASSWORD=secure_password
DB_NAME=traffic_violations
