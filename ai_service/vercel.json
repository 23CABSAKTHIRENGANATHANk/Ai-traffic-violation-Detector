{
    "version": 2,
    "runtime": "python@3.10",
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ],
    "env": {
        "PYTHONPATH": "/var/task",
        "PYTHONUNBUFFERED": "1"
    },
    "functions": {
        "app.py": {
            "memory": 3008,
            "maxDuration": 300
        }
    }
}