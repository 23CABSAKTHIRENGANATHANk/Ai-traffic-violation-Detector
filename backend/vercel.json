{
    "version": 2,
    "buildCommand": "npm install",
    "env": {
        "DB_HOST": "@db_host",
        "DB_PORT": "@db_port",
        "DB_USER": "@db_user",
        "DB_PASSWORD": "@db_password",
        "DB_NAME": "@db_name",
        "AI_SERVICE_URL": "@ai_service_url",
        "NODE_ENV": "production"
    },
    "functions": {
        "api/**/*.js": {
            "memory": 1024,
            "maxDuration": 300
        }
    }
}